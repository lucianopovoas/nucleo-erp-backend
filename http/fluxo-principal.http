### 04 - Agregados e conteudo em RASCUNHO
### Confere os totais e os snapshots antes do congelamento comercial.

# @name consultarAgregadosRascunho
GET {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}
Accept: application/json

> {%
    client.test("Agregados da V1 estao corretos", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(response.body.status.codigo === "RASCUNHO", "V1 deve estar em RASCUNHO.");
        client.assert(response.body.observacao === client.global.get("observacaoComercial"), "Observacao comercial divergente.");
        client.assert(Number(response.body.totalComercial) === 190, "totalComercial deve ser 190.00.");
        client.assert(Number(response.body.custoTotalMateriais) === 60, "custoTotalMateriais deve ser 60.00.");
        client.assert(Number(response.body.custoTotalMaoDeObra) === 60, "custoTotalMaoDeObra deve ser 60.00.");
        client.assert(Number(response.body.custoTotalDespesas) === 15, "custoTotalDespesas deve ser 15.00.");
        client.assert(Number(response.body.margemPrevista) === 55, "margemPrevista deve ser 55.00.");
        client.assert(Number(response.body.percentualMargem) === 28.95, "percentualMargem deve ser 28.95.");
    });
%}

###

# @name listarItensRascunho
GET {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}/itens
Accept: application/json

> {%
    client.test("Item comercial permanece igual", function () {
        const item = response.body.find(linha => Number(linha.id) === Number(client.global.get("itemOrcamentoId")));
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(response.body.length === 1 && Boolean(item), "Esperado exatamente o item do cenario.");
        client.assert(item.descricao === client.global.get("servicoNome"), "Snapshot do servico divergente.");
        client.assert(Number(item.quantidade) === 2 && Number(item.valorUnitario) === 100 &&
            Number(item.desconto) === 10 && Number(item.valorTotal) === 190, "Valores do item divergentes.");
    });
%}

