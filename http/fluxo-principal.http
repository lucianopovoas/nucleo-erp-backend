### Fluxo principal E2E - Nucleo ERP
###
### Uso:
### 1. Inicie PostgreSQL e a aplicacao com Java 21 e DB_PASSWORD definido externamente.
### 2. Execute "Run All Requests in File" a partir deste arquivo.
### 3. As requisicoes sao sequenciais: os handlers capturam IDs usados nos blocos seguintes.
### 4. Cada execucao cria massa propria com sufixo dinamico. Nao ha limpeza automatica.
### 5. Nao ha autenticacao no contrato atual. Quando houver, use ambiente privado do HTTP Client.

@baseUrl = http://localhost:8080

### 00 - Configuracao e pre-condicoes
### Gera o sufixo da execucao e resolve os status estruturais pelo codigo funcional.

# @name listarStatusOrcamento
< {%
    const suffix = Date.now().toString(36) + "-" + Math.floor(Math.random() * 1000000).toString(36);
    client.global.set("e2eSuffix", suffix);
    client.global.set("clienteNome", "Cliente E2E " + suffix);
    client.global.set("categoriaNome", "Categoria E2E " + suffix);
    client.global.set("servicoNome", "Servico E2E " + suffix);
    client.global.set("materialNome", "Material E2E " + suffix);
    client.global.set("unidadeMaoDeObraNome", "Hora E2E " + suffix);
    client.global.set("observacaoComercial", "Proposta comercial E2E " + suffix);
    client.global.set("descricaoMaoDeObra", "Execucao prevista E2E " + suffix);
    client.global.set("descricaoDespesa", "Deslocamento E2E " + suffix);
    client.global.set("observacaoOrdemServico", "Execucao E2E " + suffix);
%}
GET {{baseUrl}}/status-orcamentos
Accept: application/json

> {%
    client.test("Status comerciais estruturais estao ativos", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(Array.isArray(response.body), "Esperada uma colecao de status comerciais.");

        const rascunho = response.body.find(item => item.codigo === "RASCUNHO");
        const enviado = response.body.find(item => item.codigo === "ENVIADO");
        const aprovado = response.body.find(item => item.codigo === "APROVADO");

        client.assert(Boolean(rascunho) && rascunho.ativo === true, "RASCUNHO deve existir e estar ativo.");
        client.assert(Boolean(enviado) && enviado.ativo === true, "ENVIADO deve existir e estar ativo.");
        client.assert(Boolean(aprovado) && aprovado.ativo === true, "APROVADO deve existir e estar ativo.");

        if (enviado) client.global.set("statusEnviadoId", enviado.id);
        if (aprovado) client.global.set("statusAprovadoId", aprovado.id);
    });
%}

###

# @name listarStatusOrdemServico
GET {{baseUrl}}/status-ordens-servico
Accept: application/json

> {%
    client.test("Status operacionais estruturais estao ativos", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(Array.isArray(response.body), "Esperada uma colecao de status operacionais.");

        const comprarMaterial = response.body.find(item => item.codigo === "COMPRAR_MATERIAL");
        const emExecucao = response.body.find(item => item.codigo === "EM_EXECUCAO");
        const instalar = response.body.find(item => item.codigo === "INSTALAR");
        const concluido = response.body.find(item => item.codigo === "CONCLUIDO");

        client.assert(Boolean(comprarMaterial) && comprarMaterial.ativo === true,
            "COMPRAR_MATERIAL deve existir e estar ativo.");
        client.assert(Boolean(emExecucao) && emExecucao.ativo === true,
            "EM_EXECUCAO deve existir e estar ativo.");
        client.assert(Boolean(instalar) && instalar.ativo === true,
            "INSTALAR deve existir e estar ativo.");
        client.assert(Boolean(concluido) && concluido.ativo === true,
            "CONCLUIDO deve existir e estar ativo.");

        if (comprarMaterial) client.global.set("statusComprarMaterialId", comprarMaterial.id);
        if (emExecucao) client.global.set("statusEmExecucaoId", emExecucao.id);
        if (instalar) client.global.set("statusInstalarId", instalar.id);
        if (concluido) client.global.set("statusConcluidoId", concluido.id);
    });
%}

### 01 - Cadastros do cenario
### Cria somente os cadastros exigidos pelas quatro categorias de linha.

# @name criarCliente
POST {{baseUrl}}/clientes
Content-Type: application/json
Accept: application/json

{
  "nome": "{{clienteNome}}",
  "ativo": true
}

> {%
    client.test("Cliente criado", function () {
        client.assert(response.status === 201, "Esperado HTTP 201.");
        client.assert(response.body.nome === client.global.get("clienteNome"), "Nome do cliente divergente.");
        client.assert(response.body.ativo === true, "Cliente deve estar ativo.");
        client.assert(response.body.id != null, "Cliente deve possuir id.");
        client.global.set("clienteId", response.body.id);
    });
%}

