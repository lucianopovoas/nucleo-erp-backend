### 08 - Listagem e filtros de OrdemServico

# @name listarOrdensServico
GET {{baseUrl}}/ordens-servico
Accept: application/json

> {%
    client.test("Listagem sem filtros contem a OS e esta ordenada por numero", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(Array.isArray(response.body), "Esperada uma colecao.");
        client.assert(response.body.some(item => Number(item.id) === Number(client.global.get("ordemServicoId"))),
            "OS criada nao foi encontrada.");
        client.assert(response.body.every((item, index, itens) => index === 0 ||
            Number(itens[index - 1].numero) <= Number(item.numero)), "Listagem deve estar ordenada por numero ASC.");
    });
%}

