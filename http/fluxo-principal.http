# @name validarOrcamentoFinal
GET {{baseUrl}}/orcamentos/{{orcamentoId}}
Accept: application/json

> {%
    client.test("Orcamento final preserva cliente e V1 aprovada como atual", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(Number(response.body.numero) === Number(client.global.get("numeroOrcamento")),
            "Numero comercial foi alterado.");
        client.assert(Number(response.body.cliente.id) === Number(client.global.get("clienteId")),
            "Cliente do orcamento foi alterado.");
        client.assert(response.body.cliente.nome === client.global.get("clienteNome"), "Nome do cliente divergente.");
        client.assert(Number(response.body.versaoAtual.id) === Number(client.global.get("versaoId")),
            "Versao atual foi alterada.");
        client.assert(response.body.versaoAtual.status.codigo === "APROVADO", "Versao atual deve permanecer APROVADO.");
    });
%}
