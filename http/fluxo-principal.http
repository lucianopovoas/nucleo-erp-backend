### 02 - Orcamento, V1 e ownership
### A resposta de criacao do Orcamento ja identifica a versao atual V1.

# @name criarOrcamentoPrincipal
POST {{baseUrl}}/orcamentos
Content-Type: application/json
Accept: application/json

{
  "clienteId": {{clienteId}},
  "observacao": "{{observacaoComercial}}"
}

> {%
    client.test("Orcamento e V1 RASCUNHO criados", function () {
        client.assert(response.status === 201, "Esperado HTTP 201.");
        client.assert(response.body.id != null, "Orcamento deve possuir id.");
        client.assert(response.body.numero != null, "Orcamento deve possuir numero.");
        client.assert(Number(response.body.cliente.id) === Number(client.global.get("clienteId")),
            "Cliente do orcamento divergente.");
        client.assert(response.body.versaoAtual.numeroVersao === 1, "A versao inicial deve ser V1.");
        client.assert(response.body.versaoAtual.status.codigo === "RASCUNHO", "V1 deve iniciar em RASCUNHO.");

        client.global.set("orcamentoId", response.body.id);
        client.global.set("numeroOrcamento", response.body.numero);
        client.global.set("versaoId", response.body.versaoAtual.id);
    });
%}

###

