###

# @name confirmarComercialAposConclusao
GET {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}
Accept: application/json

> {%
    client.test("Conclusao operacional nao alterou o dominio comercial", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(response.body.status.codigo === "APROVADO", "V1 deve permanecer APROVADO.");
        client.assert(response.body.observacao === client.global.get("observacaoComercial"), "Observacao comercial divergente.");
        client.assert(Number(response.body.totalComercial) === 190 &&
            Number(response.body.custoTotalMateriais) === 60 &&
            Number(response.body.custoTotalMaoDeObra) === 60 &&
            Number(response.body.custoTotalDespesas) === 15 &&
            Number(response.body.margemPrevista) === 55 &&
            Number(response.body.percentualMargem) === 28.95, "Agregados comerciais divergentes.");
    });
%}

### Esperado: 400 - CONCLUIDO e terminal
# @name negarSaidaDeConcluido
PUT {{baseUrl}}/ordens-servico/{{ordemServicoId}}/status
Content-Type: application/json
Accept: application/problem+json

{
  "statusOrdemServicoId": {{statusEmExecucaoId}}
}

> {%
    client.test("Saida de CONCLUIDO retorna ProblemDetail 400", function () {
        const contentType = response.headers.valueOf("Content-Type") || "";
        client.assert(response.status === 400, "Esperado HTTP 400.");
        client.assert(contentType.toLowerCase().includes("application/problem+json"),
            "Content-Type deve conter application/problem+json.");
        client.assert(response.body && response.body.status === 400, "Body deve ser ProblemDetail 400.");
        client.assert(typeof response.body.title === "string" && response.body.title.trim().length > 0,
            "ProblemDetail deve possuir title.");
        client.assert(response.body.title === "Erro de negócio", "Title deve indicar erro de negócio.");
        client.assert(typeof response.body.detail === "string" && response.body.detail.trim().length > 0,
            "ProblemDetail deve possuir detail.");
    });
%}

### Esperado: 400 - observacao fica congelada depois de CONCLUIDO
# @name negarObservacaoConcluida
