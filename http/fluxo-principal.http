### Esperado: 404 - uma versao de outro orcamento e inexistente no contexto informado
# @name negarVersaoDeOutroOrcamento
GET {{baseUrl}}/orcamentos/{{outroOrcamentoId}}/versoes/{{versaoId}}
Accept: application/problem+json

> {%
    client.test("Ownership da versao retorna ProblemDetail 404", function () {
        const contentType = response.headers.valueOf("Content-Type") || "";
        client.assert(response.status === 404, "Esperado HTTP 404.");
        client.assert(contentType.toLowerCase().includes("application/problem+json"),
            "Content-Type deve conter application/problem+json.");
        client.assert(response.body && typeof response.body === "object", "Esperado body ProblemDetail.");
        client.assert(response.body.status === 404, "ProblemDetail deve informar status 404.");
        client.assert(response.body.title === "Recurso não encontrado",
            "Title deve indicar recurso não encontrado.");
        client.assert(typeof response.body.detail === "string" && response.body.detail.trim().length > 0,
            "ProblemDetail deve possuir detail.");
    });
%}

### 03 - Conteudo da V1
### Um registro de cada categoria, usando exatamente os DTOs de criacao atuais.

# @name criarItemOrcamento
POST {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}/itens
Content-Type: application/json
Accept: application/json

{
  "servicoId": {{servicoId}},
  "quantidade": 2.0000,
  "valorUnitario": 100.00,
  "desconto": 10.00
}

> {%
    client.test("Item comercial criado com valor total 190.00", function () {
        client.assert(response.status === 201, "Esperado HTTP 201.");
        client.assert(Number(response.body.servico.id) === Number(client.global.get("servicoId")), "Servico divergente.");
        client.assert(response.body.descricao === client.global.get("servicoNome"), "Snapshot do servico divergente.");
        client.assert(Number(response.body.quantidade) === 2, "Quantidade divergente.");
        client.assert(Number(response.body.valorUnitario) === 100, "Valor unitario divergente.");
        client.assert(Number(response.body.desconto) === 10, "Desconto divergente.");
        client.assert(Number(response.body.valorTotal) === 190, "Valor total deve ser 190.00.");
        client.global.set("itemOrcamentoId", response.body.id);
    });
%}

