        const contentType = response.headers.valueOf("Content-Type") || "";
        client.assert(response.status === 400, "Esperado HTTP 400.");
        client.assert(contentType.toLowerCase().includes("application/problem+json"),
            "Content-Type deve conter application/problem+json.");
        client.assert(response.body && response.body.status === 400, "Body deve ser ProblemDetail 400.");
        client.assert(typeof response.body.title === "string" && response.body.title.trim().length > 0,
            "ProblemDetail deve possuir title.");
        client.assert(response.body.title === "Erro de negócio", "Title deve indicar erro de negócio.");
        client.assert(typeof response.body.detail === "string" && response.body.detail.trim().length > 0,
            "ProblemDetail deve possuir detail.");
    });
%}

### 10 - Validacao final da separacao comercial e operacional

# @name validarEstadoFinalOrdemServico
GET {{baseUrl}}/ordens-servico/{{ordemServicoId}}
Accept: application/json

> {%
    client.test("Estado final da OS e CONCLUIDO e sua origem permanece coerente", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(response.body.status.codigo === "CONCLUIDO", "Estado final da OS deve ser CONCLUIDO.");
        client.assert(response.body.observacao === client.global.get("observacaoOrdemServico"),
            "Observacao operacional foi alterada depois da conclusao.");
        client.assert(Number(response.body.origem.orcamento.id) === Number(client.global.get("orcamentoId")),
            "Orcamento de origem divergente.");
        client.assert(Number(response.body.origem.versao.id) === Number(client.global.get("versaoId")),
            "Versao de origem divergente.");
        client.assert(Number(response.body.origem.cliente.id) === Number(client.global.get("clienteId")),
            "Cliente de origem divergente.");
    });
%}

###

# @name validarEstadoFinalVersao
GET {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}
Accept: application/json

> {%
    client.test("Versao comercial final permanece APROVADO e intacta", function () {
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(response.body.numeroVersao === 1, "Versao final deve continuar V1.");
        client.assert(response.body.status.codigo === "APROVADO", "Versao final deve permanecer APROVADO.");
        client.assert(response.body.observacao === client.global.get("observacaoComercial"),
            "Observacao comercial foi alterada pela evolucao operacional.");
        client.assert(Number(response.body.totalComercial) === 190, "totalComercial deve permanecer 190.00.");
        client.assert(Number(response.body.custoTotalMateriais) === 60, "custoTotalMateriais deve permanecer 60.00.");
        client.assert(Number(response.body.custoTotalMaoDeObra) === 60, "custoTotalMaoDeObra deve permanecer 60.00.");
        client.assert(Number(response.body.custoTotalDespesas) === 15, "custoTotalDespesas deve permanecer 15.00.");
        client.assert(Number(response.body.margemPrevista) === 55, "margemPrevista deve permanecer 55.00.");
        client.assert(Number(response.body.percentualMargem) === 28.95, "percentualMargem deve permanecer 28.95.");
    });
%}

###

# @name validarItemFinal
GET {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}/itens
Accept: application/json

> {%
    client.test("Item comercial final permanece intacto", function () {
        const item = response.body.find(linha => Number(linha.id) === Number(client.global.get("itemOrcamentoId")));
        client.assert(response.status === 200, "Esperado HTTP 200.");
        client.assert(response.body.length === 1 && Boolean(item), "Esperado exatamente o item original.");
        client.assert(item.descricao === client.global.get("servicoNome"), "Snapshot do servico foi alterado.");
        client.assert(Number(item.quantidade) === 2 && Number(item.valorUnitario) === 100 &&
            Number(item.desconto) === 10 && Number(item.valorTotal) === 190, "Item comercial foi alterado.");
    });
%}

