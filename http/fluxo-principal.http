### 07 - Criacao e consulta da OrdemServico

# @name criarOrdemServico
POST {{baseUrl}}/orcamentos/{{orcamentoId}}/versoes/{{versaoId}}/ordem-servico
Accept: application/json

> {%
    client.test("OrdemServico criada em COMPRAR_MATERIAL", function () {
        client.assert(response.status === 201, "Esperado HTTP 201.");
        client.assert(response.body.id != null && response.body.numero != null, "OS deve possuir id e numero.");
        client.assert(response.body.status.codigo === "COMPRAR_MATERIAL", "Status inicial deve ser COMPRAR_MATERIAL.");
        client.assert(Number(response.body.origem.orcamento.id) === Number(client.global.get("orcamentoId")),
            "Orcamento de origem divergente.");
        client.assert(Number(response.body.origem.versao.id) === Number(client.global.get("versaoId")),
            "Versao de origem divergente.");
        client.assert(Number(response.body.origem.cliente.id) === Number(client.global.get("clienteId")),
            "Cliente da origem divergente.");
        client.assert(response.body.origem.cliente.nome === client.global.get("clienteNome"), "Nome do cliente divergente.");
        client.assert(typeof response.body.criadoEm === "string", "OS deve possuir criadoEm.");

        client.global.set("ordemServicoId", response.body.id);
        client.global.set("numeroOrdemServico", response.body.numero);
        client.global.set("ordemServicoData", response.body.criadoEm.substring(0, 10));
    });
%}

